# Copiar este archivo como .env y completar con las claves reales.
# Nunca commitear el archivo .env (ya está en .gitignore).

# --- Tarea 1: motor RAG normativo ---
# LLM usado para generar la respuesta final citando norma y página.
# Dejar vacío mientras se trabaja solo con retrieval (sin llamadas a LLM).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Proveedor activo actual (ver llm.provider en config.yaml de cada tarea)
GEMINI_API_KEY=

# --- Comparación de embeddings (Fase 4, Tarea 1) ---
# Solo necesario para el brazo OpenAI de la comparación local vs. text-embedding-3-small.
OPENAI_EMBEDDINGS_API_KEY=

# --- Tarea 2: adquisición de datos OECE ---
# La API pública de contrataciones abiertas no requiere key hoy, pero se deja
# el placeholder por si el proveedor introduce autenticación.
OECE_API_KEY=
